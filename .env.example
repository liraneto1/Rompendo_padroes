# Reference only: configure these variables in Hostinger; npm start does not load .env.
NODE_ENV=production
ROMPA_BIND_ADDRESS=0.0.0.0
# PORT is assigned by the hosting platform; do not override it there.
# ROMPA_DB_PATH must point to a confirmed persistent, writable directory outside dist.
# Example for a VPS only (create the directory and grant access to the app user):
# ROMPA_DB_PATH=/var/lib/rompa/rompa.sqlite
